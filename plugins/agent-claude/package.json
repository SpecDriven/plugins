{
  "name": "@specdriven/plugin-agent-claude",
  "version": "1.0.0",
  "description": "Claude Code in the coding agent pane, with its sign-in and proxy settings",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "build": "specdriven plugin build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "specdriven": {
    "id": "agent-claude",
    "api": "1",
    "displayName": "Claude agent",
    "description": "Claude Code in the coding agent pane, with its sign-in and proxy settings",
    "host": "./dist/host.js",
    "client": "./dist/client.js",
    "src": {
      "host": "./src/host.ts",
      "client": "./src/client.tsx"
    },
    "minAppVersion": "0.1.184",
    "defaultEnabled": true,
    "autoEnable": true,
    "permissions": [
      "process:spawn",
      "settings:write",
      "secrets"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.261"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "typescript": "^5"
  }
}
