{
  "name": "hello-tab",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js"
  },
  "scripts": {
    "build": "specdriven plugin build"
  },
  "specdriven": {
    "id": "hello-tab",
    "api": "1",
    "displayName": "Hello Tab",
    "description": "Hello Tab on its own tab",
    "host": "./dist/host.js",
    "client": "./dist/client.js",
    "src": {
      "host": "./src/host.ts",
      "client": "./src/client.tsx"
    },
    "minAppVersion": "0.1.85",
    "defaultEnabled": true,
    "paths": [
      "/hello-tab"
    ],
    "permissions": [
      "data:read"
    ]
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  }
}
